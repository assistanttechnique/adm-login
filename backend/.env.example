# Copier ce fichier en .env et renseigner les valeurs (setup.ps1 / setup.sh le font automatiquement)
DJANGO_SECRET_KEY=

# Domaines autorisés, séparés par des virgules.
# En ligne (PythonAnywhere) : ajouter votre domaine, par exemple localhost,127.0.0.1,votrenom.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
