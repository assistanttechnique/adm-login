# Configuration du déploiement Docker. Copier ce fichier en .env (à côté de docker-compose.yml) et l'adapter.
# Remplacez 192.168.1.50 par l'adresse IP de la VM (commande : hostname -I) ou par son nom de domaine.

# Port d'accès au site sur la VM : http://192.168.1.50:8080
ADM_PORT=8080

# Adresses par lesquelles on accède au site, séparées par des virgules
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50

# Origines exactes (schéma + adresse + port) utilisées pour l'admin Django (/django-admin/)
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.50:8080

# false tant que le site est servi en HTTP simple ; true derrière un HTTPS (reverse proxy, tunnel…)
DJANGO_SECURE_COOKIES=false

# DJANGO_SECRET_KEY : laisser absent, une clé est générée au premier démarrage et conservée dans le volume
